						{
							"feature": {
								"id": "polder-feature-3-2",
								"name": "Graceful Retreat",
								"description": "Your small size makes it easier for you to slip away from the fray.",
								"type": "Bonus",
								"data": {
									"field": "Disengage",
									"value": 1,
